# daybook settings. copy to .env and fill in only what you use.
# an empty value means off (sources and side effects) or the default shown in brackets.
# the real environment wins over this file. never commit your .env.


# ---- identity and place
# the board's name in the masthead and tab title [Daybook]
DAYBOOK_TITLE=
# the brief's masthead [Morning Brief]
DAYBOOK_BRIEF_TITLE=
# how request texts and the prompt name the reader [you]
DAYBOOK_USER_NAME=
# the agent that takes handed-off to-dos [Agent]
DAYBOOK_AGENT_NAME=
# IANA zone for every date and clock [UTC]
DAYBOOK_TZ=
# a label for the masthead, e.g. "Lakeside"
DAYBOOK_LOCATION=
# sun times and the forecast; empty means a fixed 6:30 to 18:30 sky
DAYBOOK_LAT=
DAYBOOK_LON=
# YYYY-MM-DD of issue No. 1; empty hides the number
DAYBOOK_FIRST_EDITION=
# freeze the clock (ISO, local) for demos, tests and screenshots
DAYBOOK_NOW=

# ---- where things live
# the board's sqlite store, marks.json, today.md, requests.log [./data]
DAYBOOK_DATA=
# one folder per date: brief.json, context.json, brief.html [./briefs]
DAYBOOK_BRIEFS=
# marks.json the brief reads; empty means <DAYBOOK_DATA>/marks.json
DAYBOOK_MARKS=
# a classes/<code>/class.md folder; empty turns school off
DAYBOOK_SCHOOL=
# a folder of git repos; empty turns git activity and repo picks off
DAYBOOK_PROJECTS=
# extra folders a handed-off task may run in (os.pathsep list)
DAYBOOK_WORK_ROOTS=
# an agent dispatch folder: sessions/, ended/, reports/
DAYBOOK_SESSIONS=
# session handles look like <prefix><kebab-name> [hd-]
DAYBOOK_SESSION_PREFIX=
# a folder of devices/*.toml for the fleet room
DAYBOOK_REGISTRY=
# a services json for the fleet room (see docs/data-contracts.md)
DAYBOOK_SERVICES_FILE=
# or a command that prints that json; the file wins
DAYBOOK_SERVICES_CMD=
# a models json: what each runner may start; empty means the agent picks
DAYBOOK_MODELS=

# ---- serving. localhost unless you say otherwise
# [127.0.0.1]
DAYBOOK_HOST=
# [8740]
DAYBOOK_BOARD_PORT=
# [8735]
DAYBOOK_BRIEF_PORT=
# where the brief pages are served; empty means http://<host>:<brief port>
DAYBOOK_BRIEF_WEB=
# extra Host header names for the board (comma list), e.g. a tailnet name
DAYBOOK_ALLOWED_HOSTS=

# ---- side effects. all off until set
# an address for a prefilled sms: link to your agent
DAYBOOK_AGENT_SMS=
# a signed webhook that hands requests to your agent
DAYBOOK_WEBHOOK_URL=
DAYBOOK_WEBHOOK_SECRET=
# runs "<cmd> stop <name>" and "<cmd> revive <name>"; empty hides both
DAYBOOK_DISPATCH_CMD=
# tcp/22 reachability checks for registry devices [1]
DAYBOOK_PROBE_DEVICES=
# closes and reopens Todoist tasks when marks change
TODOIST_API_TOKEN=

# ---- the brief's generator (none of this runs in the demo)
# Claude Code CLI used by `brief generate` [claude]
DAYBOOK_CLAUDE=
# [opus]
DAYBOOK_CLAUDE_MODEL=
# refuse a run that would bill an API key [1]
DAYBOOK_REQUIRE_SUBSCRIPTION=
# [primary]
DAYBOOK_CALENDAR_ID=
# a Todoist project id to read; empty reads the inbox by name
DAYBOOK_TODOIST_PROJECT=
# comma list of extra read-only tools for the model
DAYBOOK_EXTRA_READ_TOOLS=
# "nws" for the US National Weather Service; empty turns it off
DAYBOOK_WEATHER=
# a feeds file (name<TAB>url); empty turns news feeds off
DAYBOOK_NEWS_FEEDS=
# gh CLI for open pull requests; empty turns PRs off
DAYBOOK_GH=
# an approved second-mailbox connector (see docs/integrations.md)
DAYBOOK_MAIL_HANDOFF=
# Chrome or Chromium for the PDF; empty finds one or skips the PDF
DAYBOOK_CHROME=
# the brief's closing line; empty uses a plain default
DAYBOOK_COLOPHON=
