# hand-offs to an agent gateway that accepts signed webhooks, plus session stop and revive.
# example values only. the secret belongs in your own .env, never in git.
DAYBOOK_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/daybook
DAYBOOK_WEBHOOK_SECRET=
DAYBOOK_SESSIONS=~/.agents/dispatch
DAYBOOK_SESSION_PREFIX=hd-
DAYBOOK_DISPATCH_CMD=/usr/local/bin/my-dispatch
DAYBOOK_MODELS=~/infra/models.json
DAYBOOK_PROJECTS=~/code
DAYBOOK_WORK_ROOTS=~/notes
